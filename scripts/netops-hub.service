[Unit]
Description=NetOpsWan SD-WAN Hub Central Gateway
After=network.target network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/netoswan/packages/rust-sdwan
ExecStart=/opt/netoswan/packages/rust-sdwan/target/release/netops-hub
Restart=always
RestartSec=5
LimitNOFILE=65536
Environment=RUST_LOG=info
Environment=DATABASE_URL=postgres://netops:netops_secret_pass@127.0.0.1:5432/netopswan

[Install]
WantedBy=multi-user.target
