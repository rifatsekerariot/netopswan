Version: 1.10.11-1
Depends: +libc +BUILD_NLS:libiconv-full +libstdcpp +!BUSYBOX_DEFAULT_SU:shadow-utils +!BUSYBOX_DEFAULT_SU:shadow-su +@OPENSSL_WITH_DEPRECATED +FS_WITH_FREETYPE:libfreetype +FS_WITH_ODBC:unixodbc +FS_WITH_PNG:libpng +libcurl +libedit +libopenssl +libpcre +libpthread +librt +libspandsp3 +libspeex +libspeexdsp +libsqlite3 +libuuid +sofia-sip +zlib
