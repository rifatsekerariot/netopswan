Depends: +libc +conntrack +libblobmsg-json +liblucihttp-ucode +libradcli +libubox +libubus +libuci +spotfilter +ucode +ucode-mod-log +ucode-mod-math +ucode-mod-nl80211 +ucode-mod-rtnl +uhttpd-mod-ucode +ucode-mod-uloop
